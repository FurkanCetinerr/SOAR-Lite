{
  "name": "Malicious IP Alert Playbook v3 (Auto-Firewall)",
  "trigger": {
    "event_type": "malicious_ip_detected"
  },
  "mitre_mapping": {
    "technique_id": "T1071",
    "technique_name": "Application Layer Protocol"
  },
  "steps": [
    {
      "id": 1,
      "action_type": "generate_firewall_rule",
      "params": {
        "event_type": "malicious_ip_detected",
        "ip": "{{event.ip}}"
      }
    },
    {
      "id": 2,
      "action_type": "create_incident",
      "params": {
        "severity": "high",
        "details": "Malicious IP {{event.ip}} detected. Automated firewall rule generated.",
        "extracted_observables": [
          {"type": "ip", "value": "{{event.ip}}"}
        ],
        "suggested_firewall_rule": "{{suggested_firewall_rule}}"
      }
    }
  ]
}