{
  "name": "Malicious IP Alert Playbook v3 (Refactored)",
  "trigger": {
    "event_type": "malicious_ip_detected"
  },
  "mitre_mapping": {
    "technique_id": "T1071",
    "technique_name": "Application Layer Protocol"
  },
  "steps": [
    {
      "id": 1,
      "action_type": "create_incident",
      "params": {
        "severity": "high",
        "details": "Malicious IP {{event.ip}} detected by {{event.source}}.",
        "extracted_observables": [
          {"type": "ip", "value": "{{event.ip}}"}
        ]
      }
    },
    {
      "id": 2,
      "action_type": "add_firewall_rule",
      "params": {
        "ip_address": "{{event.ip}}"
      }
    }
  ]
}