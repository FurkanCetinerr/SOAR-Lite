{
  "name": "Phishing Email Playbook v3 (Auto-Firewall)",
  "trigger": {
    "event_type": "phishing_email_detected"
  },
  "mitre_mapping": {
    "technique_id": "T1566",
    "technique_name": "Phishing"
  },
  "steps": [
    {
      "id": 1,
      "action_type": "extract_observables",
      "params": {
        "text_block": "Sender IP: {{event.source_ip}}. Email Body: {{event.email_body_text}}."
      }
    },
    {
      "id": 2,
      "action_type": "generate_firewall_rule",
      "params": { 
          "event_type": "phishing_email_detected",
          "source_ip": "{{event.source_ip}}" 
      }
    },
    {
      "id": 3,
      "action_type": "create_incident",
      "params": {
        "severity": "medium",
        "details": "Phishing attempt from {{event.sender}} to {{event.recipient}}. Source IP: {{event.source_ip}}",
        "extracted_observables": "{{extracted_observables}}",
        "suggested_firewall_rule": "{{suggested_firewall_rule}}"
      }
    }
  ]
}